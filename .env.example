# One endpoint per model, whichever role calls it (src/common/llm.py MODEL_CONNECTIONS).
# Any OpenAI-compatible endpoint serves the GPT models; GPT-6 Luna is called through the Responses API.
GPT_4O_MINI_API_KEY=
GPT_4O_MINI_BASE_URL=https://api.openai.com/v1
GPT_6_LUNA_API_KEY=
GPT_6_LUNA_BASE_URL=https://api.openai.com/v1
TEXT_EMBEDDING_3_SMALL_API_KEY=
TEXT_EMBEDDING_3_SMALL_BASE_URL=https://api.openai.com/v1
CLAUDE_OPUS_5_5_API_KEY=
CLAUDE_OPUS_5_5_BASE_URL=https://api.anthropic.com

# Optional, per model: <PREFIX>_USER_AGENT, <PREFIX>_SESSION_HEADER, <PREFIX>_SERVICE_TIER.

# Default model per role; the runners set the work and answer models themselves.
WORK_MODEL=gpt-4o-mini
ANSWER_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
